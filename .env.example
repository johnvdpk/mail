# Strato — john@aiadapt.nl

SMTP_HOST=smtp.strato.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=john@aiadapt.nl
# Use double quotes. Escape $ in passwords as \$ (Next.js dotenv-expand).
SMTP_PASS="plak-hier-het-postvak-wachtwoord"
SMTP_FROM=john@aiadapt.nl
SMTP_FROM_NAME=John van der Pouw Kraan
# Optional envelope-only BCC. Leave empty or false to disable.
SMTP_BCC=false

# IMAP — inbox sync (defaults to SMTP_USER / SMTP_PASS)
IMAP_HOST=imap.strato.com
IMAP_PORT=993
IMAP_SECURE=true
# IMAP_USER=john@aiadapt.nl
# IMAP_PASS=

# OpenRouter — AI drafts / polish / tips / inbox sort / search
OPENROUTER_AI=sk-or-v1-jouw-api-key
# Optional embedding model for semantic mail search (default: openai/text-embedding-3-small)
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Licht/snel model voor classificatie-werk (intent, keywords, polish, tips). Zelfde API key.
# OPENROUTER_MODEL=google/gemini-2.5-flash
# Zwaarder model voor kwaliteitskritische taken (klantmail-drafts, tone-regels, Leadradar-beoordeling).
# OPENROUTER_MODEL_HEAVY=anthropic/claude-sonnet-4.5

# Google Calendar (optional) — OAuth for "Zet in Google Agenda"
# Create credentials in Google Cloud Console (OAuth desktop/web client).
# Redirect URI must match exactly, e.g. http://localhost:3000/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# PostgreSQL
# Local Docker (compose maps 5434):
DATABASE_URL=postgresql://mail:mail@localhost:5434/mail
# Inside docker-compose the app overrides this to @db:5432 automatically.

# Auth — single-user web login
AUTH_PASSWORD=kies-een-sterk-wachtwoord
# true = Secure cookie (only over HTTPS). Use true on VPS behind TLS.
AUTH_SECURE=false

# Docker Compose extras (optional)
# POSTGRES_PASSWORD=mail
# POSTGRES_PORT=5434
# APP_PORT=3000

# If 465 fails, try:
# SMTP_PORT=587
# SMTP_SECURE=false
